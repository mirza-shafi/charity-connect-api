ENVIRONMENT=development

# Local dev: docker-compose maps Postgres to host port 5433 (5432 was taken
# on this machine) and Redis to the standard 6379. If running the API inside
# docker-compose itself, these get overridden to db:5432 / redis:6379.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/charity_connect
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000"]

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Local dev uses MinIO (docker-compose) as a stand-in for R2 — same S3 API,
# no real Cloudflare account needed to test uploads end to end. To switch to
# real R2 in production: clear STORAGE_ENDPOINT_URL, set R2_ACCOUNT_ID and
# real R2 access keys, and point R2_PUBLIC_BASE_URL at the R2 bucket's public
# domain. No code changes required either way.
STORAGE_ENDPOINT_URL=http://localhost:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=charity-connect
R2_PUBLIC_BASE_URL=http://localhost:9000/charity-connect
